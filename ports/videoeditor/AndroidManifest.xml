<?xml version="1.0" encoding="utf-8"?>
<!--
  Video editor for the Samsung Gallery port.
  The package and activity names are the ones Gallery's StartVideoTrimmerCmd launches
  (com.samsung.app.newtrim / .trimactivity.TrimActivity), which is the path Gallery takes on any phone
  whose floating features don't list "videoeditor" (i.e. every non-Samsung phone).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samsung.app.newtrim"
    android:versionCode="10300"
    android:versionName="1.3.0">

    <!-- With "Media management" allowed, MediaStore approves "Replace original" without asking every time. -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".trimactivity.TrimActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:screenOrientation="unspecified"
            android:resizeableActivity="true">
            <!-- Gallery: explicit component, action MAIN, data content://media/... video/* -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Any other app: "Edit with" -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Stand-alone: launcher icon opens the system video picker -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
